# Public site build (GitHub Actions secret: POKETH_ANALYTICS_API)
NEXT_PUBLIC_ANALYTICS_API=https://your-analytics-host.example

# Local dev: analytics API origin when running npm run dev
NEXT_PUBLIC_ANALYTICS_DEV=http://127.0.0.1:4173

# Analytics server (npm run analytics:start)
DASHBOARD_PASSWORD=choose-a-strong-password
ALLOWED_ORIGINS=https://poketh.site,https://www.poketh.site
TRUST_PROXY=1
TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_IP_HEADER=x-forwarded-for
PORT=4173
